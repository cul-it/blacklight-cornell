<%= form_tag '/browse', :method => :get, :class => 'search-form' do %>
  <% if !params[:authq_row].present? %>
    <div class="input-group">
      <label for="authq" class="visually-hidden">Begin browse with</label>
      <%= text_field_tag :authq, params[:authq], :placeholder => 'Dickens, Charles', :class => "search-query form-control rounded-start", :id => "authq", :autocapitalize => "off" %>
      <%= hidden_field_tag :start, params[:start], :value => '0', :id => "start" %>
      <label for="browse_type" class="visually-hidden">Browse Type</label>
      <%= select_tag :browse_type,
                     options_for_select(browse_search_bar_select,
                                        selected: params[:browse_type] || 'Author',
                                        disabled: %w[catalog:separator_1 catalog:separator_2 catalog:separator_3 catalog:separator_4]),
                     :class => 'form-select' %>
      <button id="search-btn" class="btn btn-search" type="submit">
        <i class="fa fa-search fa-inverse"></i><span class="visually-hidden"><%=t('blacklight.search.form.submit')%></span>
      </button>
    </div>
  <% end %>
<% end %>
