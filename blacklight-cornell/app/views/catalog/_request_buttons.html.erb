<% if (group == "Circulating" || group == "Rare") && !restricted_request_item %>
<% # Note that group should only ever be Circulating or Rare. %>
<% # restricted_request_item items (e.g. olin,701) are never requestable, so no buttons render for them. %>
  <%
    # Need a parameter to pass to requests that determines whether to add
    # text on the "Ask a librarian page" that the item can be scanned and
    # to return to the item view page for that.
    scan = (group == "Circulating" && !reserve_item) || !reading.empty?
  %>
  <% # Preserve the search-result position (falls back to the session, same as elsewhere the counter is used) %>
  <% counter = params[:counter] || session[:search][:counter] %>
  <% request_context_path = request_path(group, params[:id], aeon_codes, @document, scan, counter) %>
  <% request_scan_path = request_path('AEON_SCAN_REQUEST', params[:id], aeon_codes, @document, scan, counter) %>
  <% request_btn_opts = { :title => 'Request', :class => 'btn btn-danger js-request-link' } %>
  <% disabled_request_btn_opts = request_btn_opts.merge(:class => 'btn btn-danger disabled', :tabindex => '-1', :aria_disabled => 'true', :style => 'pointer-events: none;') %>
  <% scan_btn_opts = { :title => 'Request', :class => 'btn btn-outline-secondary', :id => 'id_request2' } %>
  <% pui_url = aspace_pui_url(@document) %>
  <% illiad_url = ENV['ILLIAD_URL'] %>

  <div class="item-requests">
    <% if has_non_spif_items %>
      <% if group == 'Rare' && ENV['DISABLE_AEON'] == 'true' %>
        <%= 'Reading Room delivery and scans of these materials are temporarily unavailable.' %>
      <% else %>
        <% if @document["location"].present? && pui_url.nil? %>
          <% if reserve_only %>
            <%= link_to "Request item#{reading}", "#", disabled_request_btn_opts %>
          <% else %>
            <%= link_to "Request item#{reading}", request_context_path, request_btn_opts %>
          <% end %>
          <%= link_to "Request item for scanning", request_scan_path, scan_btn_opts unless reading.empty? %>
        <% elsif @document['callnum_sort'] == "Available for the Library to Purchase" %>
          <%= link_to "Request item#{reading}", request_context_path, request_btn_opts %>
        <% end %>
      <% end %>
    <% end %>

    <%# show Archive button if the item is in Aspace %>
    <% if pui_url.present? %>
      <%= link_to "Request from Archives at Cornell", pui_url, { :title => 'Request from Archives at Cornell', :class => 'btn btn-danger' } %>
    <% end %>

    <% # only display request scan button for items not at RMC %>
    <% if (group == "Circulating" && !reserve_item && illiad_url.present?) %>
      <%= link_to 'Request scan of article/chapter', ill_scan_link(illiad_url, @document, @title, @subtitle), { :title => 'Request scan', :class => 'btn btn-outline-secondary'} %>
    <% end %>

    <% if reserve_only %>
      <br/>This item is on reserve and can't be requested for delivery. See a librarian for assistance.
    <% end %>
  </div>
<% end %>
