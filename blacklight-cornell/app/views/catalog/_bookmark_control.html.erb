<%
  bookmarks = !(BookBag.enabled? and current_user)
	bookbags = BookBag.enabled? && current_user
%>
<% if current_or_guest_user %>
  <%if bookmarks %>
    <div class="show-select-box">
      <%= render Blacklight::Document::BookmarkComponent.new(document: document, action: document_action_config) %>
    </div>
  <% end %>
  <% if bookbags && (bookbagged?(document) || can_add_books?) %>
    <%= render Blacklight::Document::BookmarkComponent.new(document:,
                                                           action: document_action_config,
                                                           checked: bookbagged?(document),
                                                           bookmark_path: add_pindex_path(document)) %>
  <% end %>
<% else %>
  &nbsp;
<% end %>
