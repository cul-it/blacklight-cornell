<form action="/search" class="single-search" id="search" method="get">
  <div class="input-group">
    <label class="visually-hidden" for="q">
      Search
    </label>
    <input class="search-query form-control rounded-start" type='text' name='q' id='q' value='<%= @query %>' placeholder='Books, articles, databases, journals and more' autocapitalize='off'>
    <button class="btn btn-search" id="search-btn" type="submit">
      <i class="fa fa-search fa-inverse"></i>
      <span class="visually-hidden">
        Search
      </span>
    </button>
  </div>
</form>
