<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>MCP console &mdash; Cornell University Library Catalog</title>
  <%= stylesheet_link_tag "mcp", media: "all" %>
</head>
<body class="mcp-console">
<main class="container py-4 py-md-5 mcp-page">
  <%= render 'mcp/brand' %>
  <h1 class="fw-semibold mb-3">Catalog MCP console</h1>
  <p class="lead text-body-secondary mb-4">
    Try the catalog tools your AI assistant uses. Choose a tool, fill in the fields or select an example,
    then run it to see the results.
  </p>

  <div class="card bg-body-secondary border-0 shadow-sm mb-4">
    <div class="card-body py-3">
      <p class="small text-uppercase fw-semibold text-body-secondary mb-2">Your connection URL</p>
      <div class="d-flex flex-wrap align-items-center gap-2">
        <code id="endpoint" class="text-body bg-body border rounded px-3 py-2 flex-grow-1"></code>
        <span class="badge text-bg-secondary" title="Server version">v<%= BlacklightMcp::VERSION %></span>
        <a class="btn btn-outline-secondary" href="/mcp">Connection guide</a>
      </div>
    </div>
  </div>

  <section class="bg-body-secondary border rounded-4 p-3 p-md-4 mb-4" aria-labelledby="run-heading">
    <div class="d-flex align-items-start gap-3 mb-4">
      <span class="mcp-step badge rounded-pill text-bg-danger fs-6 flex-shrink-0" aria-hidden="true">1</span>
      <div>
        <h2 class="h4 fw-semibold mb-1" id="run-heading">Run a tool</h2>
        <p class="text-body-secondary mb-0">Start with an example or fill in the fields below.</p>
      </div>
    </div>
    <div class="card rounded-3 shadow-sm">
      <div class="card-body p-3 p-md-4">
        <div class="mb-3">
          <label class="form-label mb-1" for="tool">Tool</label>
          <select class="form-select" id="tool">
            <option>loading&hellip;</option>
          </select>
          <p class="form-text mt-2 mcp-tool-desc" id="tool-desc"></p>
        </div>

        <div class="d-flex flex-wrap gap-2 align-items-center mb-3" id="examples"></div>

        <form id="args" autocomplete="off" class="row g-3"></form>

        <div class="d-flex flex-wrap gap-2 align-items-center mt-4">
          <button type="button" class="btn btn-danger" id="run" disabled>
            <i class="fa fa-play me-2" aria-hidden="true"></i>Run
          </button>
          <button type="button" class="btn btn-outline-secondary" id="curl">
            <i class="fa fa-clipboard me-2" aria-hidden="true"></i>Copy as curl
          </button>
          <span class="small text-body-secondary" id="status" role="status"></span>
        </div>

        <div class="form-check form-switch mt-3" id="availability-switch" hidden>
          <input class="form-check-input" type="checkbox" id="availability">
          <label class="form-check-label text-body-secondary" for="availability">
            Check availability &mdash; after the search, call check_availability as well, to show what is
            on the shelf or online under each result. Off, a search sends one request and nothing else.
          </label>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-body-secondary border rounded-4 p-3 p-md-4 mb-4" aria-labelledby="results-heading">
    <div class="d-flex align-items-start gap-3 mb-4">
      <span class="mcp-step badge rounded-pill text-bg-danger fs-6 flex-shrink-0" aria-hidden="true">2</span>
      <div>
        <h2 class="h4 fw-semibold mb-1" id="results-heading">View results</h2>
        <p class="text-body-secondary mb-0">Share a tool call by copying this page's address after running it.</p>
      </div>
    </div>
    <div id="results" class="d-grid gap-3">
      <p class="bg-body border rounded-3 p-3 p-md-4 text-body-secondary mb-0">Run a tool to see its results here.</p>
    </div>
    <details id="raw-wrap" class="bg-body border rounded-3 p-3 mt-3" hidden>
      <summary class="fw-semibold">
        <i class="fa fa-code me-1" aria-hidden="true"></i>JSON-RPC request and response
        <span id="raw-label" class="font-monospace ms-1"></span>
      </summary>
      <div class="form-check form-switch mt-2">
        <input class="form-check-input" type="checkbox" id="raw-format">
        <label class="form-check-label text-body-secondary" for="raw-format">
          Format &mdash; expand the JSON the tool answers with, instead of the escaped string it travels as
        </label>
      </div>
      <pre id="raw" class="bg-body-tertiary border rounded p-3 small mb-0 mt-2"></pre>
    </details>
  </section>

  <p class="text-body-secondary border-top pt-3 mt-5 mb-0">
    This console calls the same MCP endpoint as your AI assistant. Tools and forms are loaded from the server.
    <a href="/mcp">Back to the connection guide</a>.
  </p>

</main>

<%= javascript_include_tag "mcp_console" %>
</body>
</html>
