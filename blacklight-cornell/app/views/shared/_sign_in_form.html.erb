<form method="post" action="<%= user_saml_omniauth_authorize_path %>">
    <%= token_tag %>
    <%# OmniAuth stores this as the origin, so authentication returns to the page the user was on. %>
    <input type="hidden" name="origin" value="<%= request.original_fullpath %>">
    <button class="btn-link" type="submit" name="Sign in" onclick="javascript:_paq.push(['trackEvent', 'header_links', 'Sign in']);" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="Sign in to email items or save them to Book Bag">Sign in</button>
</form>
