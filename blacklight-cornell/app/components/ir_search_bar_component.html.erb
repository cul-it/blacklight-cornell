<div class="card card-well mb-4">
  <div class="card-body">
    <%= form_tag @url, :method => :get, :class => 'search-form col-12 col-sm-6' do %>
      <% if !params[:q_row].present? %>
        <div class="input-group">
          <label for="q" class="visually-hidden"><%= t('blacklight.search.form.q') %></label>
          <%= text_field_tag :q, params[:q], :placeholder => 'Search for institutional repository items, e.g. honeybee', :class => "form-control ir-search rounded-start", :id => "q", :autocapitalize => "off" %>
          <button class="btn btn-search" id="search-btn" type="submit">
            <i class="fa fa-search fa-inverse"></i>
            <span class="visually-hidden">
              Search
            </span>
          </button>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
<div class="return-link">
    <%= link_to url_for(search_index_path(:q => params[:q], :field => params[:field])) do %>
        <i class="fa fa-arrow-circle-left"></i>
        Back to search results
    <% end %>
</div>
</div>
