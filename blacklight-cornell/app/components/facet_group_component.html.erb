<% # Override blacklight component to customize main container for facets/limits menu %>
<div id="facets" class="facets sidenav facets-toggleable-sm">

  <div class="navbar">
    <button class="navbar-toggler navbar-toggler-right facets-toggle-btn" type="button" data-bs-toggle="collapse" data-bs-target="#facet-panel-collapse" aria-controls="facet-panel-collapse" aria-expanded="false" aria-label="Toggle facets">
	    <span class="visually-hidden">Toggle facets</span>
      <span class="navbar-toggler-icon"></span>
    </button>
  </div>

  <div id="facet-panel-collapse" class="facets-collapse collapse">
	  <%= render :partial=>'looking_for_more' %>
    <h2 class="facets-heading">
      <%= t('blacklight.search.facets.title') %>
    </h2>
    <%= body %>
  </div>
</div>
