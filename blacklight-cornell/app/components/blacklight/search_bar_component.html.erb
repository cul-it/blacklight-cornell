<div class="row">
  <div class="search-tools col-12 col-lg-8">
  
  <% if params[:action] == 'show' %>
  <%# TODO: BS5: Add back spacing with rounded and column-gap-3? %>
    <%= form_tag @url, :id => 'search-form', :method => :get, :class => 'search-form' do %>
      <%= render Blacklight::HiddenSearchStateComponent.new(params: @params) %>
      <% if !params[:q_row].present? || params[:action] == 'edit' %>
        <div class="input-group">
          <label for="q" class="visually-hidden"><%= t('blacklight.search.form.q') %></label>
          <%= text_field_tag :q, params[:q],
                               :placeholder => t('blacklight.search.form.q'),
                               :class => "search-query phone-search-query form-control rounded-start",
                               :id => "q",
                               :data => { :dynamic => "true" },
                               :autocapitalize => "off" %>
          <% if search_fields.empty? or search_fields.nil? %>
            <input type="hidden" name="search_field" value="all_fields"/>
          <% else %>
            <label for="search_field" class="visually-hidden"><%= t('blacklight.search.form.search_field.label') %></label>
            <%= select_tag(:search_field,
                            options_for_select(helpers.search_bar_select,
                                              selected:params[:search_field],
                                              disabled: ["separator_1","separator_2","separator_3","separator_4"]),
                            :title => t('blacklight.search.form.search_field.title'),
                            :class => 'form-select',
                            :data => { :dynamic => "true" } ) %>
            <span class="visually-hidden"><%= t('blacklight.search.form.search_field.post_label') %></span>
          <% end %>
          <button id="search-btn" class="btn btn-search" type="submit">
            <i class="fa fa-search fa-inverse" aria-hidden="true"></i><span class="visually-hidden"><%=t('blacklight.search.form.submit')%></span>
          </button>
        </div>
      <% end %>
    <% end %>

  <% elsif params[:controller]=='browse' %>
    <%= render :partial => 'browse/headings_search_form' %>

  <% elsif params[:controller]=='advanced_search' && (params[:q].present? || !params[:q_row].present?) || params[:action] == 'edit' %>
    <h2 class="advanced-search">Advanced Search</h2>
    
  <%else%>
    <%= form_tag @url, :id => 'search-form', :method => :get, :class => 'search-form' do %>
      <% if params[:controller] == 'blacklight_cornell_requests/request' %>
          <% @params[:format] = 'html' %>
      <% end %>
      <%= render Blacklight::HiddenSearchStateComponent.new(params: @params) %>
      <% if !params[:q_row].present? || params[:action] == 'edit' %>
          <div class="input-group">
            <label for="q" class="visually-hidden"><%= t('blacklight.search.form.q') %></label>
            <%= text_field_tag :q, params[:q],
                               :placeholder => t('blacklight.search.form.q'),
                               :class => "search-query phone-search-query form-control rounded-start",
                               :id => "q",
                               :data => { :dynamic => "true" },
                               :autocapitalize => "off" %>
            <% if search_fields.empty? or search_fields.nil? %>
               <input type="hidden" name="search_field" value="all_fields"/>
            <% else %>
              <label for="search_field" class="visually-hidden"><%= t('blacklight.search.form.search_field.label') %></label>
              <%= select_tag(:search_field,
                             options_for_select(helpers.search_bar_select,
                                                selected:params[:search_field],
                                                disabled: ["separator_1","separator_2","separator_3","separator_4"]),
                             :title => t('blacklight.search.form.search_field.title'),
                             :class => 'form-select',
                             :data => { :dynamic => "true" } ) %>
              <span class="visually-hidden"><%= t('blacklight.search.form.search_field.post_label') %></span>
            <% end %>
            <button id="search-btn" class="btn btn-search" type="submit">
              <i class="fa fa-search fa-inverse" aria-hidden="true"></i><span class="visually-hidden"><%=t('blacklight.search.form.submit')%></span>
            </button>
          </div>
      <% end %>
     <% end %>
    <% end %>

    <% if params[:q_row].present? && params[:action] != 'edit'%>
      <h2 class="advanced-search">Advanced Search</h2>
    <% end %>

  </div>

  <% if params[:controller] !='advanced_search' && !params[:q_row] %>
    <div class="search-nav col-12 col-lg-4">
      <div class="advanced-search-link">
          <%= link_to advanced_search_edit_path(helpers.convert_to_advanced_params(params)), id: 'advanced-search-link' do %>
            <i class="fa fa-search" aria-hidden="true"></i>Advanced Search
          <% end %>
      </div>
    </div>
  <% end %>

</div>

<%= javascript_include_tag 'search_form', 'data-turbo-track': 'reload' %>
