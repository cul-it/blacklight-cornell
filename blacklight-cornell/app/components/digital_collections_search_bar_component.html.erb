<div class="card card-well">
  <div class="card-body">
    <div class="search-tools">
      <%= form_tag @url, :method => :get, :class => 'search-form col-12 col-sm-6' do %>
        <% if !params[:q_row].present? %>
          <div class="input-group">
            <label for="q" class="visually-hidden"><%= t('blacklight.search.form.q') %></label>
            <%= text_field_tag :q, params[:q], :placeholder => 'Search for digital collections, e.g. hip hop', :class => "form-control rounded-start", :id => "q", :autocapitalize => "off" %>
            <% unless search_fields.empty? %>
              <label for="search_field" class="visually-hidden"><%= t('blacklight.search.form.search_field.label') %></label>
              <%= select_tag(:search_field, options_for_select(search_fields, h(params[:search_field])), :title => t('blacklight.search.form.search_field.title'), :class => 'form-select') %>
              <span class="visually-hidden"><%= t('blacklight.search.form.search_field.post_label') %></span>
            <% end %>
            <button id="search-btn" class="btn btn-search" type="submit">
              <i class="fa fa-search fa-inverse"></i><span class="visually-hidden"><%=t('blacklight.search.form.submit')%></span>
            </button>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
